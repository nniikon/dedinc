{
	"name": "dedinc",
	"displayName": "DedInC",
	"description": "DedInC compiles and runs C and C++ files with one click using a bundled or system toolchain.",
	"version": "1.1.3",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/nniikon/dedinc.git"
	},
	"engines": {
		"vscode": "^1.104.0"
	},
	"publisher": "dedinc",
	"categories": [
		"Other"
	],
	"icon": "icon/playc.v1.png",
	"activationEvents": [
		"onLanguage:c",
		"onLanguage:cpp"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"configuration": {
			"title": "DedInC",
			"properties": {
				"dedinc.compilerFlags": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"-Wshadow",
						"-Winit-self",
						"-Wredundant-decls",
						"-Wcast-align",
						"-Wundef",
						"-Wfloat-equal",
						"-Winline",
						"-Wunreachable-code",
						"-Wmissing-declarations",
						"-Wswitch-enum",
						"-Wswitch-default",
						"-Weffc++",
						"-Wextra",
						"-Wall",
						"-Wcast-qual",
						"-Wconversion",
						"-Wctor-dtor-privacy",
						"-Wempty-body",
						"-Wformat-security",
						"-Wformat=2",
						"-Wno-missing-field-initializers",
						"-Wnon-virtual-dtor",
						"-Woverloaded-virtual",
						"-Wpointer-arith",
						"-Wsign-promo",
						"-Werror=vla",
						"-D_DEBUG"
					],
					"scope": "resource",
					"markdownDescription": "Common arguments passed to the compiler on every supported operating system. These are followed by the active operating system's `dedinc.*CompilerFlags` setting. Each array entry is passed as exactly one argument."
				},
				"dedinc.windowsCompilerFlags": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"-Wmissing-include-dirs",
						"-Wmain",
						"-g",
						"-pipe",
						"-fexceptions",
						"-Wignored-qualifiers",
						"-Wlogical-op",
						"-Wstack-usage=8192",
						"-Wstrict-aliasing",
						"-Wstrict-null-sentinel",
						"-Wtype-limits",
						"-Wwrite-strings",
						"-D_EJUDGE_CLIENT_SIDE"
					],
					"scope": "resource",
					"markdownDescription": "Additional compiler arguments used only on Windows. They are appended to `dedinc.compilerFlags`."
				},
				"dedinc.linuxCompilerFlags": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"-ggdb3",
						"-std=c++17",
						"-Waggressive-loop-optimizations",
						"-Wc++14-compat",
						"-Wchar-subscripts",
						"-Wconditionally-supported",
						"-Wformat-nonliteral",
						"-Wformat-signedness",
						"-Wlogical-op",
						"-Wopenmp-simd",
						"-Wpacked",
						"-Wsign-conversion",
						"-Wstrict-null-sentinel",
						"-Wstrict-overflow=2",
						"-Wsuggest-attribute=noreturn",
						"-Wsuggest-final-methods",
						"-Wsuggest-final-types",
						"-Wsuggest-override",
						"-Wsync-nand",
						"-Wunused",
						"-Wuseless-cast",
						"-Wvariadic-macros",
						"-Wno-literal-suffix",
						"-Wno-narrowing",
						"-Wno-old-style-cast",
						"-Wno-varargs",
						"-Wstack-protector",
						"-fcheck-new",
						"-fsized-deallocation",
						"-fstack-protector",
						"-fstrict-overflow",
						"-flto-odr-type-merging",
						"-fno-omit-frame-pointer",
						"-pie",
						"-fPIE",
						"-fsanitize=address,alignment,bool,bounds,enum,float-cast-overflow,float-divide-by-zero,integer-divide-by-zero,leak,nonnull-attribute,null,object-size,return,returns-nonnull-attribute,shift,signed-integer-overflow,undefined,unreachable,vla-bound,vptr"
					],
					"scope": "resource",
					"markdownDescription": "Additional compiler arguments used only on Linux. They are appended to `dedinc.compilerFlags`."
				},
				"dedinc.macosCompilerFlags": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"-ggdb3",
						"-std=c++17",
						"-Wc++14-compat",
						"-Wchar-subscripts",
						"-Wformat-nonliteral",
						"-Wformat-signedness",
						"-Wpacked",
						"-Wsign-conversion",
						"-Wstrict-overflow=2",
						"-Wsuggest-override",
						"-Wunused",
						"-Wvariadic-macros",
						"-Wno-narrowing",
						"-Wno-old-style-cast",
						"-Wno-varargs",
						"-Wstack-protector",
						"-fcheck-new",
						"-fsized-deallocation",
						"-fstack-protector",
						"-fstrict-overflow",
						"-fno-omit-frame-pointer",
						"-Wlarger-than=8192",
						"-fPIE",
						"-fsanitize=address,alignment,bool,bounds,enum,float-cast-overflow,float-divide-by-zero,integer-divide-by-zero,nonnull-attribute,null,return,returns-nonnull-attribute,shift,signed-integer-overflow,undefined,unreachable,vla-bound,vptr"
					],
					"scope": "resource",
					"markdownDescription": "Additional compiler arguments used only on macOS. They are appended to `dedinc.compilerFlags`."
				}
			}
		},
		"commands": [
			{
				"command": "dedinc.runCCode",
				"title": "Run C/C++ Code",
				"category": "Code",
				"icon": {
					"light": "icon/play1.png",
					"dark": "icon/play1.png"
				}
			}
		],
		"keybindings": [
			{
				"command": "dedinc.runCCode",
				"key": "f9",
				"when": "editorTextFocus && (editorLangId == c || editorLangId == cpp)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "dedinc.runCCode",
					"when": "editorLangId == 'c' || editorLangId == 'cpp'",
					"group": "navigation"
				}
			]
		},
		"views": {
			"explorer": [
				{
					"id": "runCCodeButton",
					"name": "Run C/C++",
					"icon": "icon/play1.png",
					"command": "dedinc.runCCode"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "pnpm run package",
		"compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
		"package:platform": "node scripts/package-platform.mjs",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
		"check-types": "tsc --noEmit",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/vscode": "^1.104.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "22.x",
		"@typescript-eslint/eslint-plugin": "^8.42.0",
		"@typescript-eslint/parser": "^8.42.0",
		"eslint": "^9.34.0",
		"esbuild": "^0.25.9",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.2",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.5.2"
	}
}
